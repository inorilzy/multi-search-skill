{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "management",
  "description": "Main management window: only the app's own typed commands. No core/plugin APIs (fs, shell, dialog, http, opener) are granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-cookie-status",
    "allow-cookie-import",
    "allow-cookie-delete",
    "allow-detect-cli",
    "allow-start-test-search",
    "allow-poll-execution",
    "allow-cancel-test-search",
    "allow-skill-plan",
    "allow-skill-install",
    "allow-install-plan",
    "allow-install-cli",
    "allow-skill-status",
    "allow-skill-update",
    "allow-skill-remove-plan",
    "allow-skill-remove",
    "allow-update-cli",
    "allow-uninstall-cli",
    "allow-user-path-plan",
    "allow-user-path-change",
    "allow-credential-status",
    "allow-credential-read",
    "allow-credential-reveal",
    "allow-credential-application-open",
    "allow-credential-save",
    "allow-credential-delete",
    "allow-credential-test",
    "allow-credential-append",
    "allow-credential-remove",
    "allow-migration-plan",
    "allow-migration-apply",
    "allow-settings-view",
    "allow-settings-save",
    "allow-scrape-settings-save",
    "allow-provider-list",
    "allow-scrape-memory-view",
    "allow-scrape-memory-pin",
    "allow-scrape-memory-reset"
  ]
}
